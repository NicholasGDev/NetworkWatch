{
  "manifest_version": 3,
  "name": "NetWatch - privacidade de telas",
  "version": "1.0",
  "description": "Reduz sinais de posição e extensão de telas expostos a sites no Firefox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "netwatch-screen-privacy@local"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN",
      "js": ["screen.js"]
    }
  ]
}
